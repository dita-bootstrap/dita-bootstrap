    </section>
    <bodydiv border="yes" padding="3" deliveryTarget="html">
      <table rowsep="1" colsep="1">
        <tgroup cols="2">
          <colspec colname="COLSPEC0"/>
          <colspec colname="COLSPEC1"/>
          <thead>
            <row>
